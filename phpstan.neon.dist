parameters:
    level: 5
    paths:
        - src
    scanFiles:
        - vendor/woocommerce/action-scheduler/functions.php
        - universal-telegram-functions.php
        # WooCommerce is a genuinely optional runtime dependency (ADR-0003),
        # never a Composer require — these are declaration-only stubs (no
        # runtime code), added as a dev-only static-analysis aid so PHPStan
        # can type-check M03's WooCommerce event emitters
        # (src/Integrations/WooCommerce/Events/), which reference WC_Order/
        # WC_Product/wc_get_order() etc. only inside the
        # WooCommerceSupport::is_active() gated code path.
        - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
    scanDirectories:
        - vendor/woocommerce/action-scheduler/classes

    ignoreErrors:
        -
            # RuleSimulator's anonymous RuleEvaluator subclass binds
            # $entries_ref by reference to simulate()'s own local $entries
            # variable, which is read after evaluate() returns. PHPStan's
            # property-usage analysis does not track cross-scope
            # by-reference constructor bindings, so it sees only writes.
            message: '#Property .*\$entries_ref is never read, only written#'
            path: src/Automations/RuleSimulator.php

includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
