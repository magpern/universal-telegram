<?xml version="1.0"?>
<ruleset name="UniversalTelegram">
	<description>Coding standard for the Telegram Operations Hub plugin.</description>

	<file>universal-telegram.php</file>
	<file>uninstall.php</file>
	<file>src</file>
	<file>tests</file>
	<file>bin/check-doc-links.php</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>

	<arg value="sp"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="4"/>

	<config name="minimum_wp_version" value="6.9"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress-Extra">
		<!-- PSR-4 class files (src/Core/Plugin.php) instead of class-plugin.php. -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="WooCommerce-Core">
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="universal-telegram"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="universal_telegram"/>
				<element value="UNIVERSAL_TELEGRAM"/>
				<element value="UniversalTelegram"/>
			</property>
		</properties>
	</rule>

	<!-- Test method names are self-describing; don't demand full docblocks
	     there, matching this Product Owner's other PSR-4 plugins. -->
	<rule ref="Squiz.Commenting.FunctionComment.Missing">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.FunctionComment.MissingParamTag">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Commenting.DocComment.MissingShort">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.ClassComment.Missing">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.VariableComment.Missing">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.FileComment.Missing">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<!-- Test files legitimately override globals and load files dynamically. -->
	<rule ref="WordPress.WP.GlobalVariablesOverride">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<!-- Deterministic test doubles (e.g. a fixed-value RetryPolicy jitter
	     closure) legitimately ignore a parameter required only to match a
	     callable's own signature. -->
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<!-- tests/integration/bootstrap.php defines the WordPress test framework's
	     own documented $wp_tests_dir local convention and writes a startup
	     diagnostic to STDERR before WordPress itself is loaded. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>*/tests/integration/bootstrap.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions.file_system_operations_fwrite">
		<exclude-pattern>*/tests/integration/bootstrap.php</exclude-pattern>
	</rule>

	<!-- This fail-closed codebase never renders a caught exception's message
	     directly to any surface; only small, fixed, stable codes ever reach
	     an administrator, a log entry, or a diagnostic page (docs/adr/0006,
	     0007, 0008). This sniff's heuristic for "an exception message
	     reaches output" produces pervasive false positives against typed,
	     enum-backed internal exceptions throughout src/, so it is disabled
	     plugin-wide rather than excluded file by file. -->
	<rule ref="WordPress.Security.EscapeOutput.ExceptionNotEscaped">
		<severity>0</severity>
	</rule>

	<!-- bin/check-doc-links.php is a standalone CLI script, never loaded by
	     WordPress: STDERR diagnostics and reading local Markdown files are
	     its own normal, non-web-facing operation, not WordPress runtime
	     output or filesystem access needing WP_Filesystem/escaping. -->
	<rule ref="WordPress.WP.AlternativeFunctions.file_get_contents_file_get_contents">
		<exclude-pattern>*/bin/check-doc-links.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions.file_system_operations_fwrite">
		<exclude-pattern>*/bin/check-doc-links.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.Security.EscapeOutput.OutputNotEscaped">
		<exclude-pattern>*/bin/check-doc-links.php</exclude-pattern>
	</rule>

	<!-- BotManagementController::handle_request() verifies the nonce once,
	     centrally, via check_admin_referer(), before dispatching to any of
	     its own private per-operation handler methods (docs/adr/0010's
	     pattern, applied across method boundaries instead of within a
	     single method as SelfTest::handle_request() does) — this sniff
	     cannot trace that a caller already verified the nonce, so it is
	     disabled for this one file rather than adding a repetitive ignore
	     comment to every $_POST access across a dozen private methods. -->
	<rule ref="WordPress.Security.NonceVerification.Missing">
		<exclude-pattern>*/src/Administration/Telegram/BotManagementController.php</exclude-pattern>
		<exclude-pattern>*/src/Administration/Automations/RuleBuilderRequestHandler.php</exclude-pattern>
	</rule>

	<!-- M02's own event_type identifiers are a fixed, lower-case,
	     dot-namespaced format (e.g. "wordpress.user_registered" —
	     M02 plan §5.1's ^[a-z][a-z0-9]*(\.[a-z][a-z0-9_]*)+$ contract), not
	     prose referring to the WordPress project by name. This sniff's
	     "WordPress" capitalization heuristic cannot distinguish the two and
	     produces pervasive false positives against every literal event-type
	     string, so it is disabled specifically for the Events/Automations
	     boundaries (both source and tests) where those literals live. -->
	<rule ref="WordPress.WP.CapitalPDangit">
		<exclude-pattern>*/src/Events/*</exclude-pattern>
		<exclude-pattern>*/src/Automations/*</exclude-pattern>
		<exclude-pattern>*/src/Administration/Automations/*</exclude-pattern>
		<exclude-pattern>*/tests/unit/Events/*</exclude-pattern>
		<exclude-pattern>*/tests/unit/Automations/*</exclude-pattern>
		<exclude-pattern>*/tests/integration/Events/*</exclude-pattern>
		<exclude-pattern>*/tests/integration/Automations/*</exclude-pattern>
		<exclude-pattern>*/tests/integration/Administration/Automations/*</exclude-pattern>
		<exclude-pattern>*/tests/integration/Persistence/MigratorEventsSchemaTest.php</exclude-pattern>
		<exclude-pattern>*/src/Integrations/WooCommerce/Events/*</exclude-pattern>
		<exclude-pattern>*/tests/integration/Integrations/WooCommerce/*</exclude-pattern>
	</rule>

	<!-- Every WordPress core hook this milestone's emitters attach to
	     (wp_login, wp_login_failed, user_register, set_user_role,
	     after_password_reset, transition_post_status, comment_post,
	     activated_plugin, deactivated_plugin, upgrader_process_complete,
	     rest_request_after_callbacks, wp_mail_failed) and the Action
	     Scheduler hook this milestone subscribes to
	     (action_scheduler_failed_action) is, by definition, someone else's
	     hook name the plugin is merely subscribing to, never firing itself
	     — neither this plugin's own prefix nor its own docblock convention
	     applies to a name it does not own. -->
	<!-- M03's WooCommerce event emitters (src/Integrations/WooCommerce/Events/)
	     subscribe only to WooCommerce core hooks (woocommerce_*) they do
	     not own or define, exactly the same situation as the WordPress-core
	     hooks excluded above; their integration tests fire those same
	     third-party hooks directly via do_action()/apply_filters(). -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedHooknameFound">
		<exclude-pattern>*/src/Events/*</exclude-pattern>
		<exclude-pattern>*/tests/integration/Events/*</exclude-pattern>
		<exclude-pattern>*/src/Integrations/WooCommerce/Events/*</exclude-pattern>
		<exclude-pattern>*/tests/integration/Integrations/WooCommerce/*</exclude-pattern>
	</rule>
	<rule ref="WooCommerce.Commenting.CommentHooks">
		<exclude-pattern>*/src/Events/*</exclude-pattern>
		<exclude-pattern>*/tests/integration/Events/*</exclude-pattern>
		<exclude-pattern>*/src/Integrations/WooCommerce/Events/*</exclude-pattern>
		<exclude-pattern>*/tests/integration/Integrations/WooCommerce/*</exclude-pattern>
	</rule>

	<!-- Every M02 event-emitter callback's own parameter list is fixed by
	     the WordPress core (or Action Scheduler) hook signature it
	     subscribes to, not chosen by this plugin — e.g. LoginEmitter::
	     on_login_failed()'s $error, UserLifecycleEmitter::on_password_reset()'s
	     $new_pass (deliberately never read, M02 plan §5.5's privacy
	     guarantee), ScheduledTaskFailureEmitter::on_action_failed()'s
	     $error. Trimming an unused trailing parameter would only work by
	     coincidence of argument position and silently break if the
	     upstream hook's own signature ever adds a parameter before it. -->
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
		<exclude-pattern>*/src/Events/Emitters/*</exclude-pattern>
		<exclude-pattern>*/src/Integrations/WooCommerce/Events/*</exclude-pattern>
	</rule>
</ruleset>
